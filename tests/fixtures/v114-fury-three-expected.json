  "uncertainties": [
    {
      "topic": "Duplicate perk",
      "passage": "feature/fury/level-2/perk.md: 'You gain one crafting, exploration, or intrigue perk of your choice.'",
      "issue": "All six witnesses already hold Teamwork (exploration) from the Soldier career. The Compendium found no rule forbidding or allowing taking the same perk twice.",
      "alternatives": [
        "Exclude already-held perks from the level-2 choice",
        "Allow re-selection (no benefit)"
      ],
      "handling": "Teamwork is listed as group-eligible but no witness selects it."
    },
    {
      "topic": "Perk list scope",
      "passage": "perk/ contains 47 mcdm.heroes.v1 perks and 8 mcdm.beastheart.v1 perks; chapter/perks.md in the unified tree is the Beastheart chapter ('can be taken only by beastheart characters').",
      "issue": "Beastheart perks (e.g. Born Tracker, Wilds Explorer, Trained Thief) are excluded as class-restricted; group membership for core perks comes from the Heroes book because unified perk frontmatter carries no group field.",
      "alternatives": ["Derive groups from another source if one exists in the pin"],
      "handling": "Eligible list = Heroes book Crafting, Exploration and Intrigue Perks headings."
    },
    {
      "topic": "Perks with further sub-choices or granted actions",
      "passage": "perk/area-of-expertise.md ('Choose one skill you already have from the crafting skill group'); perk/friend-catapult.md ('As a maneuver, ...')",
      "issue": "Some eligible perks need a follow-up choice or grant an action. No witness picks them, so no expected values are asserted for them.",
      "alternatives": [],
      "handling": "Listed as eligible only."
    },
    {
      "topic": "Flat damage without characteristic",
      "passage": "Apex Predator '4/6/10 damage', Visceral Roar '2/5/7 damage', Phalanx-Breaker '2/4/6 damage' (unified files and Heroes book agree).",
      "issue": "Unlike Death... Death! ('3 + M'), these print no characteristic term. Not ambiguous in the source; recorded so an implementation does not add M by pattern.",
      "alternatives": [],
      "handling": "Values taken literally."
    },
    {
      "topic": "Stormwight form",
      "passage": "feature/fury/stormwight-kits/kit-bonuses.md: bonuses apply in true, animal and hybrid form.",
      "issue": "Witness sheet values are for true form, as in v101; animal/hybrid form size or stat changes, Growing Ferocity thresholds and optional bonuses are not included.",
      "alternatives": [],
      "handling": "True-form sheet values only."
    }
  ],

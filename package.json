{
  "name": "salient",
  "private": true,
  "license": "GPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "check": "pnpm lint && pnpm check:engine && pnpm check:app && pnpm check-links && pnpm check-vendor && pnpm content:check && pnpm build",
    "test": "vitest run --project engine",
    "play": "node src/cli.ts",
    "demo": "node src/cli.ts demo",
    "character:sources": "node scripts/inspect-character-sources.ts",
    "dev": "vite --host 0.0.0.0",
    "dev:backend": "convex dev",
    "build": "tsc -p tsconfig.web.json && vite build",
    "check:engine": "tsc --noEmit && vitest run --project engine",
    "check:app": "tsc -p tsconfig.web.json && vitest run --project app --project scripts",
    "test:app": "vitest run --project app",
    "test:browser": "playwright test",
    "app": "node scripts/app.ts",
    "content:build": "node scripts/build-content.ts",
    "content:check": "node scripts/build-content.ts --check",
    "content:seed": "node scripts/seed-content.ts",
    "setup:local": "node scripts/setup-local.ts",
    "prepare": "simple-git-hooks",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check-links": "node scripts/check-links.ts",
    "check-vendor": "node scripts/check-vendor.ts",
    "check-commit": "node scripts/check-commit.ts",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "4.0.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "convex-test": "0.0.57",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "shadcn": "4.21.0",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@convex-dev/better-auth": "0.12.5",
    "@tanstack/react-router": "1.170.34",
    "better-auth": "1.6.15",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "convex": "1.45.0",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "packageManager": "pnpm@11.5.3",
  "simple-git-hooks": {
    "commit-msg": "[ ! -f scripts/check-commit.ts ] || node scripts/check-commit.ts \"$1\""
  }
}

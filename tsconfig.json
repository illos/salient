{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./web/*"] }
  },
  "include": [
    "src/**/*.ts",
    "shared/contracts/*.ts",
    "shared/resolve/*.ts",
    "tests/*.test.ts",
    "scripts/inspect-character-sources.ts",
    "scripts/check-commit.ts",
    "scripts/check-links.ts",
    "scripts/check-vendor.ts",
    "scripts/lib/**/*.ts"
  ]
}

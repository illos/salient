  "include": ["web", "shared", "convex", "tests/app", "tests/browser", "tests/scripts", "scripts/lib", "scripts/check-commit.ts", "scripts/check-links.ts", "scripts/app.ts", "scripts/setup-local.ts", "scripts/build-foe-source.ts", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
